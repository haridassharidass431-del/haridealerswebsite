# ==========================================
# HARI DEALERS - ENVIRONMENT CONFIGURATION
# ==========================================

# Next.js Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------
# SUPABASE DATABASE & STORAGE
# ------------------------------------------
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# ADMIN PORTAL
# ------------------------------------------
# Set unique credentials for your deployment (never use NEXT_PUBLIC_ variables).
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=change-this-before-deploying
# Required: use a random secret with at least 32 characters. Never reuse the Supabase service-role key.
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# ------------------------------------------
# RAZORPAY PAYMENT GATEWAY
# ------------------------------------------
# Obtain from Razorpay Dashboard -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# ------------------------------------------
# TRANSACTIONAL EMAIL (Resend / SMTP)
# ------------------------------------------
EMAIL_FROM=orders@haridealers.com
ADMIN_EMAIL=haridealers@gmail.com
RESEND_API_KEY=re_placeholder_api_key

# ------------------------------------------
# STORE SETTINGS
# ------------------------------------------
NEXT_PUBLIC_STORE_NAME="Hari Dealers"
NEXT_PUBLIC_STORE_PHONE="+91 7339635485"
NEXT_PUBLIC_STORE_EMAIL="haridealers@gmail.com"

# Google sign-in is configured in Supabase Dashboard > Authentication > Providers > Google.
# Add http://localhost:3000/auth/callback and your production /auth/callback URL
# to the Supabase Auth redirect allow list.
